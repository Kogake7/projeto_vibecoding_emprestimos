# Runtime: Supavisor transaction pooler, porta 6543.
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1"

# Migrations: conexão direta ou session pooler, porta 5432.
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@HOST:5432/postgres"

SUPABASE_URL="https://PROJECT.supabase.co"
SUPABASE_ANON_KEY="replace-me"
